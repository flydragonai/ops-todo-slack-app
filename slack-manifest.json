{
  "display_information": {
    "name": "CS Hub",
    "description": "Turn Slack messages into CS Hub tickets and track them"
  },
  "features": {
    "bot_user": {
      "display_name": "cs-hub",
      "always_online": true
    },
    "shortcuts": [
      {
        "name": "Create ticket",
        "type": "message",
        "callback_id": "create_task_from_message",
        "description": "Create a CS Hub ticket from this message (and its thread)"
      }
    ],
    "slash_commands": [
      {
        "command": "/add-task",
        "url": "https://ops-todo-slack-app.vercel.app/api/slack",
        "description": "Create a ticket",
        "usage_hint": "[ticket description]",
        "should_escape": false
      },
      {
        "command": "/next-task",
        "url": "https://ops-todo-slack-app.vercel.app/api/slack",
        "description": "Your next ticket, or unassigned ones up for grabs",
        "usage_hint": "[any]",
        "should_escape": false
      },
      {
        "command": "/all-tasks",
        "url": "https://ops-todo-slack-app.vercel.app/api/slack",
        "description": "Show all open tickets",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "chat:write.public",
        "pins:write",
        "pins:read",
        "channels:read",
        "reactions:read",
        "channels:history",
        "groups:history",
        "users:read",
        "users:read.email",
        "groups:read"
      ],
      "user": [
        "chat:write"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://ops-todo-slack-app.vercel.app/api/slack"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false,
    "event_subscriptions": {
      "request_url": "https://ops-todo-slack-app.vercel.app/api/slack",
      "bot_events": [
        "reaction_added"
      ]
    }
  }
}
